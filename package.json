{
  "name": "@grimmdev/goose-wasm",
  "version": "0.1.3",
  "description": "Client-side WebAssembly compiler, linter, transpiler, and real-time WebGL renderer for the Goose programming language",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer.d.ts",
      "import": "./dist/renderer.mjs",
      "require": "./dist/renderer.js",
      "default": "./dist/renderer.js"
    },
    "./linter": {
      "types": "./dist/goose_linter.d.ts",
      "default": "./dist/goose_linter.js"
    },
    "./legacy": {
      "types": "./dist/legacy.d.ts",
      "import": "./dist/legacy.mjs",
      "require": "./dist/legacy.js"
    },
    "./runner": {
      "types": "./dist/runtime/compiledRunner.d.ts",
      "import": "./dist/runner.mjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/grimmdev/Goose-WASM.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build:wasm": "node scripts/build-compiler.cjs",
    "build:ts": "node scripts/bundle.cjs",
    "build": "npm run build:wasm && npm run build:ts",
    "test": "npm run test:shaders && npm run test:build-jobs && node scripts/test.cjs",
    "deps": "node scripts/fetch-deps.cjs",
    "build:shader-tools": "node scripts/build-shader-tools.cjs",
    "build:web-libs": "node scripts/build-web-libs.cjs",
    "build:demos": "node scripts/build-demos.cjs",
    "test:shaders": "node tests/web-shaders.test.cjs",
    "test:browser": "node tests/browser.test.cjs",
    "build:browser-probes": "node scripts/build-browser-probes.cjs",
    "build:runner-fixtures": "node scripts/build-runner-fixtures.cjs",
    "test:build-jobs": "node tests/build-jobs.test.cjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.0.0",
    "playwright": "1.62.1"
  },
  "keywords": [
    "goose",
    "compiler",
    "wasm",
    "webassembly",
    "transpiler",
    "linter",
    "webgl",
    "renderer",
    "shader"
  ],
  "author": "GrimmDev",
  "license": "MIT"
}