From: Goose WASM Builder <builder@honk.io>
Subject: [PATCH] Add Emscripten WebAssembly build target

Enables building Goose as a WebAssembly module for Web, Node.js, and mobile
webviews with an embedded standard library, JSON diagnostics, and transpilation.
---
 CMakeLists.txt | 35 +++++++++++++++++++++++++++++++++++
 1 file changed, 35 insertions(+)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 1000000..2000000 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -107,6 +107,11 @@ target_include_directories(goose PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/version")
 find_package(Threads REQUIRED)
 target_link_libraries(goose PRIVATE Threads::Threads)
+# The library the process runner (process.cpp) is built on.
 target_include_directories(goose PRIVATE third_party/subprocess)
+
+if(EMSCRIPTEN)
+    target_sources(goose PRIVATE src/stubs.c)
+    target_compile_definitions(goose PRIVATE
+        GOOSE_BUILTIN_RSPDIR_physics=nullptr
+        GOOSE_BUILTIN_RSPDIR_gfx=nullptr
+    )
+endif()
 
 # A program run in-process runs on the main thread (main.cpp), whose stack the
@@ -144,6 +149,35 @@ target_link_libraries(goose PRIVATE goose_shaderc)
 
+# In WebAssembly, JIT execution via TinyCC is replaced by the stub interface
+if(EMSCRIPTEN)
+    set(WASM_FLAGS
+        "-sALLOW_MEMORY_GROWTH"
+        "-sSTACK_SIZE=16777216"
+        "-sINITIAL_MEMORY=67108864"
+        "-sENVIRONMENT=node,web,worker"
+        "-sMODULARIZE=1"
+        "-sEXPORT_NAME=createGooseLinter"
+        "-sSINGLE_FILE=1"
+        "-sFORCE_FILESYSTEM=1"
+        "-sEXPORTED_RUNTIME_METHODS=['callMain','FS']"
+        "--embed-file=${CMAKE_CURRENT_SOURCE_DIR}/stdlib@/stdlib"
+    )
+    target_link_options(goose PRIVATE ${WASM_FLAGS})
+    set_target_properties(goose PROPERTIES
+        OUTPUT_NAME "goose_linter"
+        SUFFIX ".js"
+    )
+else()
 # The in-process C backend: TinyCC, vendored under third_party/tinycc and
 # built into every compiler (cmake/libtcc.cmake).
 include(cmake/libtcc.cmake)
 target_link_libraries(goose PRIVATE libtcc)
 add_dependencies(goose tcc_runtime)
+endif()
-- 

